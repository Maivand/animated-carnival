<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_bg"
    android:padding="20dp">

    <!-- Top bar: title + a single small settings affordance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/jarvis_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/gear"
            android:textColor="@color/jarvis_text_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Center: the one button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_live"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/mic_idle"
            android:text="@string/mic_idle"
            android:textColor="@color/jarvis_on_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/voice_status_idle"
            android:textColor="@color/jarvis_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Media surface (voice-triggered: images, video, web) -->
    <LinearLayout
        android:id="@+id/media_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/media_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/media_image_description"
            android:maxHeight="280dp"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/media_video"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone" />

        <WebView
            android:id="@+id/media_web"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/media_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_media_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_close" />
    </LinearLayout>

    <!-- Live log / activity (long-press to share for diagnosis) -->
    <TextView
        android:id="@+id/voice_console"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:scrollbars="vertical"
        android:textColor="@color/jarvis_text_muted"
        android:textSize="11sp" />
</LinearLayout>
